{
  "name": "dsh-deepseek-search",
  "version": "1.1.0",
  "description": "DeepSeek 搜索：多引擎网页搜索、正文抓取与深度资料收集插件（DeepSeek Harness）",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-search",
    "search-engine",
    "research"
  ],
  "author": "a2042798096-debug",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2042798096-debug/dsh-deepseek-search.git"
  },
  "bugs": {
    "url": "https://github.com/a2042798096-debug/dsh-deepseek-search/issues"
  },
  "homepage": "https://github.com/a2042798096-debug/dsh-deepseek-search#readme",
  "license": "MIT",
  "scripts": {
    "test": "node test/offline.test.mjs && node test/client.test.mjs",
    "test:offline": "node test/offline.test.mjs",
    "test:client": "node test/client.test.mjs",
    "test:host": "node test/host.test.mjs",
    "test:engines": "node test/engines.test.mjs",
    "test:extract": "node test/extract.test.mjs",
    "test:research": "node test/research.test.mjs"
  }
}
